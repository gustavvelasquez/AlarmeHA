<?xml version="1.0" encoding="utf-8"?>
<!-- 0.9.0: visual do Relógio da Samsung. Cada item é um cartão de grupo (pílula) OU um alarme solto
     (fatia do cartão único dos soltos, com divisória). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarm_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp">

    <LinearLayout
        android:id="@+id/ha_group_pill"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginBottom="10dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/ha_group_avatar"
            android:layout_width="46dp"
            android:layout_height="46dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alarm_vector"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ha_group_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="170dp"
                android:maxLines="1"
                android:textSize="18sp"
                tools:text="Trabalho" />

            <TextView
                android:id="@+id/ha_group_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="qui., 22 de out." />
        </LinearLayout>

        <ImageView
            android:id="@+id/ha_group_count_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alarm_vector" />

        <TextView
            android:id="@+id/ha_group_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="18sp"
            tools:text="4" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/alarm_solo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/alarm_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/alarm_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@drawable/selector"
            android:paddingStart="30dp"
            android:paddingTop="18dp"
            android:paddingEnd="14dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/alarm_label_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toStartOf="@id/alarm_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/alarm_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="15sp"
                    tools:text="Remédio manhã" />

                <TextView
                    android:id="@+id/alarm_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="@string/ha_skipped_past"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/alarm_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="44sp"
                app:layout_constraintEnd_toStartOf="@id/alarm_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/alarm_label_row"
                tools:text="09:00" />

            <org.fossify.clock.ha.HaDaysView
                android:id="@+id/alarm_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/alarm_time" />

            <TextView
                android:id="@+id/alarm_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/alarm_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/alarm_week"
                tools:text="qua., 21 de out." />

            <org.fossify.commons.views.MyMaterialSwitch
                android:id="@+id/alarm_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/alarm_drag_handle"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/alarm_drag_handle"
                android:layout_width="@dimen/drag_handle_size"
                android:layout_height="@dimen/drag_handle_size"
                android:paddingHorizontal="@dimen/medium_margin"
                android:src="@drawable/ic_drag_handle_vector"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>
